function addSmartChips() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('Transactions');
  if (!sheet) return;

  const categories = new Set();
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return;

  const cats = sheet.getRange(2, COL.CATEGORY + 1, lastRow - 1, 1).getValues();
  for (const [c] of cats) {
    if (c) categories.add(String(c));
  }

  // Создаём лист со справочником категорий (для Data Validation + чипов)
  let catSheet = ss.getSheetByName('_categories');
  if (!catSheet) {
    catSheet = ss.insertSheet('_categories');
    catSheet.hideSheet();
  } else {
    catSheet.clear();
  }

  const catList = Array.from(categories).sort();
  catSheet.getRange(1, 1, catList.length, 1).setValues(catList.map(c => [c]));

  // Добавляем Data Validation на колонку Category
  const catRange = sheet.getRange(2, COL.CATEGORY + 1, Math.max(lastRow - 1, 100), 1);
  const rule = SpreadsheetApp.newDataValidation()
    .requireValueInRange(catSheet.getRange(1, 1, catList.length, 1))
    .build();
  catRange.setDataValidation(rule);
}

