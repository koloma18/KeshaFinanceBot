    reportSheet.getRange(rowPtr, 1).setValue('💸 Расходы');
    reportSheet.getRange(rowPtr, 1).setFontWeight('bold').setFontColor('#c62828');
    rowPtr += 1;

    setRow(['Категория', 'Кол-во', 'UAH', 'USD', 'EUR']);
    reportSheet.getRange(rowPtr - 1, 1, 1, 5).setFontWeight('bold').setBackground('#ffebee');

    // Сортируем расходы по сумме (по убыванию)
    const sortedExpenses = Object.entries(data.expense).sort((a, b) => b[1].UAH - a[1].UAH);
    for (const [cat, vals] of sortedExpenses) {
      setRow([cat, vals.count, vals.UAH, vals.USD, vals.EUR]);
    }

    setRow(['Итого расход', '', totals[month].expense.UAH, totals[month].expense.USD, totals[month].expense.EUR]);
    reportSheet.getRange(rowPtr - 1, 1, 1, 5).setFontWeight('bold').setBackground('#ffcdd2');

    rowPtr += 1;

    // Баланс
    const balanceUAH = totals[month].income.UAH - totals[month].expense.UAH;
    reportSheet.getRange(rowPtr, 1).setValue(`💰 Баланс за ${month}: ${balanceUAH.toFixed(2)} UAH`);
    reportSheet.getRange(rowPtr, 1).setFontWeight('bold').setFontSize(12);
    if (balanceUAH >= 0) {
      reportSheet.getRange(rowPtr, 1).setFontColor('#2e7d32');
    } else {
      reportSheet.getRange(rowPtr, 1).setFontColor('#c62828');
    }

    rowPtr += 2; // отступ между месяцами
  }

  reportSheet.autoResizeColumns(1, 5);
  reportSheet.setColumnWidth(1, 200);
  reportSheet.setFrozenRows(0);

  // Добавляем сводный лист
  createSummarySheet();
}

// ============================================================
// СВОДНАЯ ПО ВСЕМ МЕСЯЦАМ
// ============================================================

function createSummarySheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const transactionSheet = ss.getSheetByName('Transactions');
  if (!transactionSheet) return;

  let summarySheet = ss.getSheetByName('Summary');
  if (summarySheet) {
    ss.deleteSheet(summarySheet);
  }
  summarySheet = ss.insertSheet('Summary');

  const lastRow = transactionSheet.getLastRow();
  if (lastRow < 2) return;

  const data = transactionSheet.getRange(2, 1, lastRow - 1, HEADERS.length).getValues();

  // Собираем по месяцам
  const monthly = {};
  for (const row of data) {
    const month = String(row[COL.MONTH] || '');
    const type = String(row[COL.TYPE] || '');
    const amountUAH = Number(row[COL.AMOUNT_UAH]) || 0;

    if (!monthly[month]) monthly[month] = { income: 0, expense: 0 };
    if (type === 'income') monthly[month].income += amountUAH;
    else monthly[month].expense += amountUAH;
  }

  // Заголовки
  const headers = ['Month', 'Income', 'Expense', 'Balance', 'Savings Rate'];
  summarySheet.getRange(1, 1, 1, headers.length).setValues([headers]);
  summarySheet.getRange(1, 1, 1, headers.length)
    .setFontWeight('bold')
    .setBackground('#1a1a2e')
    .setFontColor('#ffffff');

  // Данные
  let rowNum = 2;
  for (const [month, vals] of Object.entries(monthly)) {
    const balance = vals.income - vals.expense;
    const savingsRate = vals.income > 0
      ? ((vals.income - vals.expense) / vals.income * 100).toFixed(1) + '%'
      : 'N/A';

    summarySheet.getRange(rowNum, 1).setValue(month);
    summarySheet.getRange(rowNum, 2).setValue(vals.income);
    summarySheet.getRange(rowNum, 3).setValue(vals.expense);
    summarySheet.getRange(rowNum, 4).setValue(balance);
    summarySheet.getRange(rowNum, 5).setValue(savingsRate);

    // Цвет баланса
    if (balance >= 0) {
      summarySheet.getRange(rowNum, 4).setFontColor('#2e7d32');
    } else {
      summarySheet.getRange(rowNum, 4).setFontColor('#c62828');
    }

    rowNum++;
  }

  // Итого
  const totalIncome = Object.values(monthly).reduce((s, v) => s + v.income, 0);
  const totalExpense = Object.values(monthly).reduce((s, v) => s + v.expense, 0);
  const totalBalance = totalIncome - totalExpense;

  summarySheet.getRange(rowNum, 1).setValue('TOTAL');
  summarySheet.getRange(rowNum, 1).setFontWeight('bold');
  summarySheet.getRange(rowNum, 2).setValue(totalIncome).setFontWeight('bold');
  summarySheet.getRange(rowNum, 3).setValue(totalExpense).setFontWeight('bold');
  summarySheet.getRange(rowNum, 4).setValue(totalBalance).setFontWeight('bold');
  summarySheet.getRange(rowNum, 4).setFontColor(totalBalance >= 0 ? '#2e7d32' : '#c62828');

  summarySheet.autoResizeColumns(1, headers.length);
  summarySheet.setFrozenRows(1);
}

// ============================================================
// SMART CHIPS — превращение категорий в чипы
// ============================================================

function addSmartChips() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Transactions');
  if (!sheet) return;

  const categories = new Set();
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return;

  const cats = sheet.getRange(2, COL.CATEGORY + 1, lastRow - 1, 1).getValues();
  for (const [c] of cats) {
    if (c) categories.add(String(c));
  }

  // Создаём лист со справочником категорий (для Data Validation + чипов)
  let catSheet = ss.getSheetByName('_categories');
  if (!catSheet) {
    catSheet = ss.insertSheet('_categories');
    catSheet.hideSheet();
  } else {
    catSheet.clear();
  }

  const catList = Array.from(categories).sort();
  catSheet.getRange(1, 1, catList.length, 1).setValues(catList.map(c => [c]));

  // Добавляем Data Validation на колонку Category
  const catRange = sheet.getRange(2, COL.CATEGORY + 1, Math.max(lastRow - 1, 100), 1);
  const rule = SpreadsheetApp.newDataValidation()
    .requireValueInRange(catSheet.getRange(1, 1, catList.length, 1))
    .build();
  catRange.setDataValidation(rule);
}

// ============================================================
// ВАЛИДАЦИЯ ТИПА
// ============================================================

function setupValidation() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Transactions');
  if (!sheet) return;

  // Type validation
  const typeRange = sheet.getRange(2, COL.TYPE + 1, sheet.getLastRow(), 1);
  const typeRule = SpreadsheetApp.newDataValidation()
    .requireValueInList(['income', 'expense'])
    .build();
  typeRange.setDataValidation(typeRule);

  // Source validation
  const sourceRange = sheet.getRange(2, COL.SOURCE + 1, sheet.getLastRow(), 1);
  const sourceRule = SpreadsheetApp.newDataValidation()
    .requireValueInList(['manual', 'monobank'])
    .build();
  sourceRange.setDataValidation(sourceRule);
}

