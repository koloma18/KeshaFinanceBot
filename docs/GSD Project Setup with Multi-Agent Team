function generateMonthlyReport() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('Transactions');
  if (!sheet) {
    SpreadsheetApp.getUi().alert('Нет листа "Transactions"');
    return;
  }

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) {
    SpreadsheetApp.getUi().alert('Нет данных для отчёта');
    return;
  }

  // Собираем данные
  const data = sheet.getRange(2, 1, lastRow - 1, HEADERS.length).getValues();

  // Группируем по месяцу и категории
  const report = {};
  const totals = {};

  for (const row of data) {
    const month = String(row[COL.MONTH] || '');
    const type = String(row[COL.TYPE] || '').toLowerCase();
    const category = String(row[COL.CATEGORY] || 'Прочее');
    const amountUAH = Number(row[COL.AMOUNT_UAH]) || 0;
    const amountUSD = Number(row[COL.AMOUNT_USD]) || 0;
    const amountEUR = Number(row[COL.AMOUNT_EUR]) || 0;

    if (!report[month]) {
      report[month] = { income: {}, expense: {} };
      totals[month] = { income: { UAH: 0, USD: 0, EUR: 0 }, expense: { UAH: 0, USD: 0, EUR: 0 } };
    }

    const catType = type === 'income' ? 'income' : 'expense';

    if (!report[month][catType][category]) {
      report[month][catType][category] = { count: 0, UAH: 0, USD: 0, EUR: 0 };
    }

    report[month][catType][category].count++;
    report[month][catType][category].UAH += amountUAH;
    report[month][catType][category].USD += amountUSD;
    report[month][catType][category].EUR += amountEUR;
    totals[month][catType].UAH += amountUAH;
    totals[month][catType].USD += amountUSD;
    totals[month][catType].EUR += amountEUR;
  }

  // Создаём лист отчёта
  const reportSheetName = 'Report_' + new Date().toISOString().slice(0, 10);
  let reportSheet = ss.getSheetByName(reportSheetName);
  if (reportSheet) {
    ss.deleteSheet(reportSheet);
  }
  reportSheet = ss.insertSheet(reportSheetName);

  let rowPtr = 1;
  const setRow = (values) => {
    reportSheet.getRange(rowPtr++, 1, 1, values.length).setValues([values]);
  };

  // Стили заголовков
  const headerStyle = { fontWeight: 'bold', background: '#1a1a2e', fontColor: '#ffffff' };

  for (const [month, data] of Object.entries(report)) {
    // Заголовок месяца
    reportSheet.getRange(rowPtr, 1).setValue(`📊 ${month}`);
    reportSheet.getRange(rowPtr, 1).setFontWeight('bold').setFontSize(14);
    rowPtr += 1;

    // Доходы
    reportSheet.getRange(rowPtr, 1).setValue('💰 Доходы');
    reportSheet.getRange(rowPtr, 1).setFontWeight('bold').setFontColor('#2e7d32');
    rowPtr += 1;

    setRow(['Категория', 'Кол-во', 'UAH', 'USD', 'EUR']);
    reportSheet.getRange(rowPtr - 1, 1, 1, 5).setFontWeight('bold').setBackground('#e8f5e9');

    for (const [cat, vals] of Object.entries(data.income)) {
      setRow([cat, vals.count, vals.UAH, vals.USD, vals.EUR]);
    }

    setRow(['Итого доход', '', totals[month].income.UAH, totals[month].income.USD, totals[month].income.EUR]);
    reportSheet.getRange(rowPtr - 1, 1, 1, 5).setFontWeight('bold').setBackground('#c8e6c9');

    rowPtr += 1;

    // Расходы
    reportSheet.getRange(rowPtr, 1).setValue('💸 Расходы');
    reportSheet.getRange(rowPtr, 1).setFontWeight('bold').setFontColor('#c62828');
    rowPtr += 1;

    setRow(['Категория', 'Кол-во', 'UAH', 'USD', 'EUR']);
    reportSheet.getRange(rowPtr - 1, 1, 1, 5).setFontWeight('bold').setBackground('#ffebee');

    // Сортируем расходы по сумме (по убыванию)
    const sortedExpenses = Object.entries(data.expense).sort((a, b) => b[1].UAH - a[1].UAH);
    for (const [cat, vals] of sortedExpenses) {
      setRow([cat, vals.count, vals.UAH, vals.USD, vals.EUR]);
    }

    setRow(['Итого расход', '', totals[month].expense.UAH, totals[month].expense.USD, totals[month].expense.EUR]);
    reportSheet.getRange(rowPtr - 1, 1, 1, 5).setFontWeight('bold').setBackground('#ffcdd2');

    rowPtr += 1;

    // Баланс
    const balanceUAH = totals[month].income.UAH - totals[month].expense.UAH;
    reportSheet.getRange(rowPtr, 1).setValue(`💰 Баланс за ${month}: ${balanceUAH.toFixed(2)} UAH`);
    reportSheet.getRange(rowPtr, 1).setFontWeight('bold').setFontSize(12);
    if (balanceUAH >= 0) {
      reportSheet.getRange(rowPtr, 1).setFontColor('#2e7d32');
    } else {
      reportSheet.getRange(rowPtr, 1).setFontColor('#c62828');
    }

    rowPtr += 2; // отступ между месяцами
  }

  reportSheet.autoResizeColumns(1, 5);
  reportSheet.setColumnWidth(1, 200);
  reportSheet.setFrozenRows(0);

  // Добавляем сводный лист
  createSummarySheet();
}

