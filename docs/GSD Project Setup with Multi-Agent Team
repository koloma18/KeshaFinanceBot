};

const DEFAULT_CATEGORY_COLOR = '#F5F5F5';

// ============================================================
// КОЛОНКИ (0-индексация)
// ============================================================

const COL = {
  MONTH:      0, // A
  DATE:       1, // B
  TYPE:       2, // C
  AMOUNT_UAH: 3, // D
  AMOUNT_USD: 4, // E
  AMOUNT_EUR: 5, // F
  CATEGORY:   6, // G
  COMMENT:    7, // H
  SOURCE:     8, // I
};

const HEADERS = [
  'Month', 'Date', 'Type', 'Amount UAH', 'Amount USD',
  'Amount EUR', 'Category', 'AI Comment', 'Source'
];

// ============================================================
// МЕНЮ
// ============================================================

function onOpen() {
  const ui = SpreadsheetApp.getUi();
  ui.createMenu('📊 Financial Tracker')
    .addItem('Generate Monthly Report', 'generateMonthlyReport')
    .addItem('Add Sample Data', 'addSampleData')
    .addSeparator()
    .addItem('Reset Category Colors', 'applyCategoryColors')
    .addToUi();
}

// ============================================================
// АВТО-РАСКРАСКА КАТЕГОРИЙ
// ============================================================

function onEdit(e) {
  // Срабатывает при редактировании колонки Category
  if (!e || e.range.getColumn() !== COL.CATEGORY + 1) return;

  const sheet = e.range.getSheet();
  if (sheet.getName() !== 'Transactions') return;

  const row = e.range.getRow();
  if (row === 1) return; // пропускаем заголовок

  const category = e.value || '';
  const color = CATEGORY_COLORS[category] || DEFAULT_CATEGORY_COLOR;

  // Окрашиваем всю строку
  const numCols = HEADERS.length;
  sheet.getRange(row, 1, 1, numCols).setBackground(color);
}

/**
 * Применить цвета ко всем существующим категориям
 */
function applyCategoryColors() {
  const sheet = SpreadsheetApp.getActiveSheet();
  if (sheet.getName() !== 'Transactions') {
    sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Transactions');
  }
  if (!sheet) {
    SpreadsheetApp.getUi().alert('Нет листа "Transactions"');
    return;
  }

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return;

  const categories = sheet.getRange(2, COL.CATEGORY + 1, lastRow - 1, 1).getValues();
  const numCols = HEADERS.length;

  for (let i = 0; i < categories.length; i++) {
    const cat = String(categories[i][0] || '');
    const color = CATEGORY_COLORS[cat] || DEFAULT_CATEGORY_COLOR;
    sheet.getRange(i + 2, 1, 1, numCols).setBackground(color);
  }
}

// ============================================================
// ФОРМАТИРОВАНИЕ ТАБЛИЦЫ
// ============================================================

function formatSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName('Transactions');
  if (!sheet) {
    sheet = ss.insertSheet('Transactions');
  }

  // Заголовки
  sheet.getRange(1, 1, 1, HEADERS.length).setValues([HEADERS]);
  sheet.getRange(1, 1, 1, HEADERS.length)
    .setFontWeight('bold')
    .setBackground('#1a1a2e')
    .setFontColor('#ffffff')
    .setHorizontalAlignment('center');

  // Формат даты
  sheet.getRange('B:B').setNumberFormat('dd.mm.yyyy');

  // Формат валют
  sheet.getRange('D:D').setNumberFormat('#,##0.00');
  sheet.getRange('E:E').setNumberFormat('#,##0.00');
  sheet.getRange('F:F').setNumberFormat('#,##0.00');

  // Автоширина
  sheet.autoResizeColumns(1, HEADERS.length);
  // Ширина для комментария
  sheet.setColumnWidth(COL.COMMENT + 1, 300);
}

