function onEdit(e) {
  // Срабатывает при редактировании колонки Category
  if (!e || e.range.getColumn() !== COL.CATEGORY + 1) return;

  const sheet = e.range.getSheet();
  if (sheet.getName() !== 'Transactions') return;

  const row = e.range.getRow();
  if (row === 1) return; // пропускаем заголовок

  const category = e.value || '';
  const color = CATEGORY_COLORS[category] || DEFAULT_CATEGORY_COLOR;

  // Окрашиваем всю строку
  const numCols = HEADERS.length;
  sheet.getRange(row, 1, 1, numCols).setBackground(color);
}

/**
